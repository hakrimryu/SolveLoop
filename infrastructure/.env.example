POSTGRES_DB=solveloop
POSTGRES_USER=solveloop_local
# 公開用の例です。.envではローカル専用のランダムな値に置き換えてください。
POSTGRES_PASSWORD=
# APIのホスト公開先は127.0.0.1に限定します。
BACKEND_PORT=8000
# ローカルHTTP用。HTTPSを使う場合はSecureを有効にし、Originを明示します。
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
AUTH_COOKIE_SECURE=false
