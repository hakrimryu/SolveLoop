POSTGRES_DB=solveloop
POSTGRES_USER=solveloop_local
# 公開用の例です。.envではローカル専用のランダムな値に置き換えてください。
POSTGRES_PASSWORD=
# APIのホスト公開先は127.0.0.1に限定します。
BACKEND_PORT=8000
# ローカルHTTP用。HTTPSを使う場合はSecureを有効にし、Originを明示します。
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:5174"]
AUTH_COOKIE_SECURE=false
# WindowsホストのOllamaへ接続します。ホスト実行時は127.0.0.1を指定します。
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 接続試験用の候補です。最終採用は日本語の品質評価後に判断します。
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=embeddinggemma-2:270m-q8_0-text
OLLAMA_GENERATE_TIMEOUT_SECONDS=120
OLLAMA_EMBED_TIMEOUT_SECONDS=120
